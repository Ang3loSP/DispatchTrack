# DispatchTrack Environment Variables
# Copy to .env (local) or set in hosting platform (Render, GitHub Actions)

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Neon PostgreSQL connection string (production)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dispatchtrack?sslmode=require
# Local dev: use docker-compose PostgreSQL (see docker-compose.yml)
ConnectionStrings__Default=postgresql://postgres:postgres@localhost:5432/dispatchtrack?Include%20Error%20Detail=true

# =============================================================================
# JWT AUTHENTICATION (Required)
# =============================================================================
# Must be at least 32 characters (256 bits). Generate with: openssl rand -base64 32
Jwt__Secret=your-super-secret-jwt-key-at-least-32-chars-long-change-in-production
Jwt__Issuer=DispatchTrack
Jwt__Audience=DispatchTrack

# =============================================================================
# REDIS CACHE (Optional - Non-critical per architecture)
# =============================================================================
# Upstash Redis TLS connection string (production)
# Format: rediss://:password@host:port
# Leave empty to use in-memory cache (local dev default)
ConnectionStrings__Redis=

# =============================================================================
# MIGRATIONS (Production only)
# =============================================================================
# Set to "true" on Render to auto-apply EF Core migrations at startup
# Local dev: leave "false" or unset (run `dotnet ef database update` manually)
MigrateOnStartup=false

# =============================================================================
# ASP.NET CORE
# =============================================================================
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# FRONTEND (Vite dev server)
# =============================================================================
# API base URL for Vite proxy (must match docker-compose API port)
VITE_API_BASE_URL=http://localhost:5084