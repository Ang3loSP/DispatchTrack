# PostgreSQL connection string (Neon serverless or local postgres:16-alpine)
ConnectionStrings__Default="Host=ep-xxxx.eu-central-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD_HERE;SSL Mode=Require;"

# JWT Configuration (Secret must be at least 32 characters / 256 bits)
Jwt__Secret="YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARS_LONG"
Jwt__Issuer="DispatchTrack"
Jwt__Audience="DispatchTrack"

# Redis (optional — leave empty for local dev; dashboard then uses an in-memory cache).
# Upstash: rediss://default:PASSWORD@HOST:6379 (TLS via ssl=true in the URL)
ConnectionStrings__Redis=""
